{
  "name": "chipboy-studio",
  "version": "1.3.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "android:sync": "pnpm build && cap sync android",
    "android:debug": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "pnpm android:sync && cd android && ./gradlew assembleRelease",
    "android:lint": "cd android && ./gradlew lint",
    "fdroid:lint": "bash scripts/check-fdroid.sh",
    "android:icons": "capacitor-assets generate --android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.1"
  },
  "description": "A pocket-sized chiptune studio in the browser: sequencer, piano roll, drum machine, riff library, sampler, FX rack and WAV export.",
  "license": "MIT",
  "author": {
    "name": "Chipboy Studio contributors"
  },
  "homepage": "https://github.com/ones-is-lord/chipboy-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ones-is-lord/chipboy-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ones-is-lord/chipboy-studio/issues"
  },
  "keywords": [
    "chiptune",
    "music",
    "sequencer",
    "piano-roll",
    "sampler",
    "web-audio",
    "react",
    "typescript",
    "8-bit",
    "game-boy",
    "riff",
    "music-generator"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.21.0"
}
